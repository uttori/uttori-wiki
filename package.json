  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "concurrency": 10,
    "failFast": false,
    "tap": false,
    "timeout": "2m",
    "verbose": true
  },
  "c8": {
    "clean": true,
    "per-file": true,
    "check-coverage": false,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [],
    "exclude-after-remap": true
  },
  "release-it": {
    "github": {
      "release": true
    }
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "make": "npm run make-docs",
    "make-docs": "time node build/make-docs.js",
    "release": "release-it",
    "pretest": "npm run build && tsc -p test/types/tsconfig.json",
    "test": "AVA_FAST=1 NODE_ENV=test c8 ava",
    "test:full": "NODE_ENV=test c8 ava",
    "test:slow": "NODE_ENV=test c8 ava test/plugins/search-sqlite.test.js test/plugins/search-provider-sqlite.test.js",
    "test-debug": "DEBUG=Uttori* NODE_ENV=test ava --serial --concurrency=1",
    "validate": "npm ls",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "pretest:full": "npm run pretest",
    "pretest:slow": "npm run build",
    "pretest-debug": "npm run build",
    "premake-docs": "npm run build",
    "pretest:types": "npm run build",
    "test:types": "tsc -p test/types/tsconfig.json"
  },
  "directories": {
    "test": "test"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "allowScripts": {
    "pre-commit@2.0.0": true,
    "better-sqlite3@13.0.3": true
  },
  "main": "dist/index.js"
}
